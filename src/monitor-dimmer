#!/usr/bin/env python3
"""Monitor Dimmer daemon. `monitor-dimmer --restore` undoes a leftover DDC dim."""
import os
import re
import signal
import subprocess
import sys
import threading
import time
from pathlib import Path

import dimmer_common as dc

CFG = dc.load_config()

game_active  = False
overlay_proc = None
dim_lock     = threading.RLock()     # tray thread and monitor loop both dim


# ── Detection ─────────────────────────────────────────────────────────────────

def is_vlc_fullscreen():
    if not CFG["vlc_fullscreen"]:
        return False
    try:
        names = subprocess.run(
            ["gdbus", "call", "--session", "--dest", "org.freedesktop.DBus",
             "--object-path", "/org/freedesktop/DBus",
             "--method", "org.freedesktop.DBus.ListNames"],
            capture_output=True, text=True, timeout=2).stdout
        # one name per VLC window: org.mpris.MediaPlayer2.vlc[.instanceNNN]
        for name in set(re.findall(r"org\.mpris\.MediaPlayer2\.vlc[\w.]*", names)):
            r = subprocess.run(
                ["gdbus", "call", "--session", "--dest", name,
                 "--object-path", "/org/mpris/MediaPlayer2",
                 "--method", "org.freedesktop.DBus.Properties.Get",
                 "org.mpris.MediaPlayer2", "Fullscreen"],
                capture_output=True, text=True, timeout=2)
            if "true" in r.stdout:
                return True
    except (OSError, subprocess.TimeoutExpired):
        pass
    return False


_STEAM_HELPER_PATHS = (
    "/ubuntu12_32/",
    "/ubuntu12_64/",
    "/.steam/root/",
    "/steam-runtime/",
    "/pressure-vessel/",
)

def _has_steam_game_id(pid_dir):
    """Check if process has SteamGameId env var set to a non-zero value (i.e. it's a game, not the Steam client)."""
    try:
        environ = (pid_dir / "environ").read_bytes()
        if b"SteamGameId=" not in environ:
            return False
        for entry in environ.split(b"\x00"):
            if entry.startswith(b"SteamGameId="):
                val = entry.split(b"=", 1)[1]
                if not (val.isdigit() and int(val) > 0):
                    return False
                try:
                    exe = os.readlink(pid_dir / "exe")
                    if any(p in exe for p in _STEAM_HELPER_PATHS):
                        return False
                except OSError:
                    pass
                return True
    except OSError:
        pass
    return False


# /proc/*/exe is fully resolved: on Fedora Atomic /home is a symlink to
# /var/home, so match both the configured and the resolved spelling
GAME_DIRS = sorted({d.rstrip("/") + "/" for p in CFG["game_paths"]
                    for d in (p, os.path.realpath(p))})

def _in_game_dir(path):
    return any(path.startswith(d) for d in GAME_DIRS)


def _is_game_launch_arg(arg):
    # Wine shows the game as "Z:\home\...\game.exe"; only count executables,
    # so a file manager or shell sitting in a game folder doesn't trigger
    arg = arg.replace("\\", "/")
    if arg[1:3] == ":/":
        arg = arg[2:]
    return arg.lower().endswith(".exe") and _in_game_dir(arg)


def _is_game_process_running():
    for pid_dir in Path("/proc").iterdir():
        if not pid_dir.name.isdigit():
            continue
        try:
            if _has_steam_game_id(pid_dir):
                return True
            if GAME_DIRS:
                if _in_game_dir(os.readlink(pid_dir / "exe")):
                    return True
                args = (pid_dir / "cmdline").read_bytes().decode("utf-8", errors="ignore")
                if any(_is_game_launch_arg(a) for a in args.split("\x00")):
                    return True
        except OSError:
            continue
    return False


def _is_any_window_fullscreen():
    """True if an X11/XWayland window is fullscreen. Without xdotool/xprop
    (or for native Wayland games) this can't be known: assume fullscreen."""
    try:
        out = subprocess.check_output(
            ["xdotool", "search", "--onlyvisible", "--name", ""],
            stderr=subprocess.DEVNULL, text=True, timeout=3
        ).split()
    except FileNotFoundError:
        return True
    except (subprocess.SubprocessError, OSError):
        return True
    for wid in out:
        try:
            props = subprocess.check_output(
                ["xprop", "-id", wid, "_NET_WM_STATE"],
                stderr=subprocess.DEVNULL, text=True, timeout=2
            )
        except FileNotFoundError:
            return True
        except (subprocess.SubprocessError, OSError):
            continue
        if "_NET_WM_STATE_FULLSCREEN" in props:
            return True
    return False


def is_game_running():
    game = _is_game_process_running()
    if game and CFG["require_fullscreen"]:
        game = _is_any_window_fullscreen()
    return game or is_vlc_fullscreen()


# ── Dimming ───────────────────────────────────────────────────────────────────

def start_overlay():
    global overlay_proc
    if overlay_proc and overlay_proc.poll() is None:
        return
    if not dc.has_target(CFG):
        dc.warn("no dim target configured — run `dimmer` and choose a monitor")
        return
    cmd = [sys.executable, str(dc.OVERLAY_BIN), "--opacity", str(CFG["dim_level"] / 100)]
    for flag, key in (("--model", "target_model"), ("--sn", "target_sn"),
                      ("--connector", "target_connector")):
        if CFG[key]:
            cmd += [flag, CFG[key]]
    overlay_proc = subprocess.Popen(cmd)


def stop_overlay():
    global overlay_proc
    if overlay_proc and overlay_proc.poll() is None:
        overlay_proc.terminate()
        try:
            overlay_proc.wait(timeout=2)
        except subprocess.TimeoutExpired:
            overlay_proc.kill()
    overlay_proc = None


def ddc_dim():
    if dc.load_state():
        return                                   # already dimmed
    bus = dc.find_target_bus(CFG)
    if bus is None:
        dc.warn("dim target monitor not found via ddcutil")
        return
    level = dc.get_brightness(bus)
    if level is None:
        dc.warn(f"can't read brightness on i2c-{bus}")
        return
    current, _max = level
    # Remember the user's brightness on disk, so a crash or `systemctl stop`
    # mid-game can still restore it (see restore_leftover_dim)
    dc.save_state({"bus": bus, "brightness": current})
    dc.set_brightness(bus, dc.dimmed_value(current, CFG["dim_level"]))


def ddc_restore():
    state = dc.load_state()
    if not state:
        return
    # Re-locate the monitor: the bus may have changed since dimming
    bus = dc.find_target_bus(CFG)
    if bus is None:
        bus = state["bus"]
    if dc.set_brightness(bus, state["brightness"]):
        dc.clear_state()


def dim_on():
    with dim_lock:
        if CFG["use_overlay"]:
            start_overlay()
        else:
            ddc_dim()


def dim_off():
    with dim_lock:
        stop_overlay()
        ddc_restore()


# ── Tray ──────────────────────────────────────────────────────────────────────

def make_icon(active):
    from PIL import Image, ImageDraw
    size = 64
    img  = Image.new("RGBA", (size, size), (0, 0, 0, 0))
    d    = ImageDraw.Draw(img)

    # Colours: white active, dim grey inactive — blends with any panel colour
    fg      = (255, 255, 255, 230) if active else (180, 180, 180, 140)
    fg_dim  = (255, 255, 255, 70)  if active else (180, 180, 180, 50)

    # Monitor frame
    d.rounded_rectangle([3, 4, 61, 46], radius=4, outline=fg, width=3)
    # Left half bright
    d.rectangle([4, 5, 32, 45], fill=fg)
    # Right half dimmed
    d.rounded_rectangle([32, 5, 60, 45], radius=3, fill=fg_dim)
    # Divider line
    d.line([32, 5, 32, 45], fill=fg, width=2)
    # Stand
    d.line([22, 46, 42, 46], fill=fg, width=3)
    d.rounded_rectangle([16, 50, 48, 56], radius=2, fill=fg)

    return img


def monitor_loop():
    global game_active
    while True:
        time.sleep(CFG["poll_interval"])
        running = is_game_running()
        with dim_lock:
            was_active, game_active = game_active, running
            if running and not was_active:
                dim_on()
            elif not running and was_active:
                dim_off()


def on_toggle_mode(icon, item):
    with dim_lock:
        dimming = game_active
        if dimming:
            dim_off()
        CFG["use_overlay"] = not CFG["use_overlay"]
        if dimming:
            dim_on()
    icon.update_menu()


def on_settings(icon, item):
    wizard = Path(__file__).resolve().parent / "dimmer"
    if not dc.open_in_terminal([sys.executable, str(wizard)]):
        dc.warn("no terminal emulator found — run `dimmer` from a terminal")


def shutdown(*_):
    dim_off()
    os._exit(0)


def on_quit(icon, item):
    shutdown()


def import_pystray():
    try:
        import pystray
        return pystray
    except Exception as e:
        # PYSTRAY_BACKEND=appindicator fails hard when AppIndicator is missing
        if os.environ.pop("PYSTRAY_BACKEND", None):
            for mod in [m for m in sys.modules if m.startswith("pystray")]:
                del sys.modules[mod]
            try:
                import pystray
                return pystray
            except Exception as e2:
                e = e2
        dc.warn(f"tray icon unavailable ({e}); running without it")
        return None


def run_tray(pystray):
    icon = pystray.Icon("monitor-dimmer")
    icon.icon = make_icon(True)
    icon.title = "Monitor Dimmer"
    icon.menu = pystray.Menu(
        pystray.MenuItem(
            lambda item: "Mode: Overlay" if CFG["use_overlay"] else "Mode: DDC Brightness",
            on_toggle_mode,
        ),
        pystray.MenuItem("Settings", on_settings),
        pystray.MenuItem("Quit", on_quit),
    )
    icon.run()


def restore_leftover_dim():
    """A previous run died while dimming: put the brightness back."""
    if dc.load_state():
        ddc_restore()


def migrate_config():
    """Old configs only store a bus number: record who sits on it now."""
    if dc.has_target(CFG) or CFG["target_bus"] is None:
        return
    for d in dc.ddc_displays():
        if d["bus"] == CFG["target_bus"]:
            dc.set_target(CFG, d)
            dc.save_config(CFG)
            print(f"Dim target identified as {dc.monitor_label(d)}; saved to config", flush=True)
            return


def main():
    if "--restore" in sys.argv[1:]:
        restore_leftover_dim()
        return

    restore_leftover_dim()
    migrate_config()
    signal.signal(signal.SIGTERM, shutdown)
    signal.signal(signal.SIGINT, shutdown)
    threading.Thread(target=monitor_loop, daemon=True).start()

    pystray = import_pystray()
    if pystray:
        try:
            run_tray(pystray)
        except Exception as e:
            # e.g. no notification service / no tray host on this desktop
            dc.warn(f"tray icon failed ({e}); running without it")
    while True:
        signal.pause()


if __name__ == "__main__":
    main()
