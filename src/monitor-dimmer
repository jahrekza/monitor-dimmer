#!/usr/bin/env python3
import os
import sys
import time
import subprocess
import threading
from pathlib import Path

try:
    import pystray
    from PIL import Image, ImageDraw
except ImportError:
    print("Missing pystray or Pillow", file=sys.stderr)
    sys.exit(1)

CONFIG_FILE = Path.home() / ".config/monitor-dimmer.conf"
OVERLAY_BIN = Path.home() / ".local/bin/monitor-dimmer-overlay"

game_active  = False
overlay_proc = None
lock         = threading.Lock()


def load_config():
    cfg = {
        "dim_level":      70,
        "poll_interval":  5,
        "use_overlay":    True,
        "right_bus":      None,
        "game_paths":     [],
        "vlc_fullscreen": True,
    }
    try:
        for line in CONFIG_FILE.read_text().splitlines():
            line = line.strip()
            if not line or line.startswith("#"):
                continue
            k, _, v = line.partition("=")
            k, v = k.strip(), v.strip()
            if k == "dim_level":
                cfg["dim_level"] = int(v)
            elif k == "poll_interval":
                cfg["poll_interval"] = int(v)
            elif k == "use_overlay":
                cfg["use_overlay"] = v.lower() == "true"
            elif k == "right_bus":
                cfg["right_bus"] = int(v)
            elif k == "game_paths":
                cfg["game_paths"] = [p.strip() for p in v.split(",") if p.strip()]
            elif k == "vlc_fullscreen":
                cfg["vlc_fullscreen"] = v.lower() == "true"
    except FileNotFoundError:
        pass
    return cfg


CFG           = load_config()
DIM_LEVEL     = CFG["dim_level"]
POLL_INTERVAL = CFG["poll_interval"]
USE_OVERLAY   = CFG["use_overlay"]
RIGHT_BUS     = CFG["right_bus"]
GAME_PATHS    = CFG["game_paths"]
VLC_FULLSCREEN = CFG["vlc_fullscreen"]


def is_vlc_fullscreen():
    if not VLC_FULLSCREEN:
        return False
    try:
        r = subprocess.run(
            ["qdbus", "org.mpris.MediaPlayer2.vlc",
             "/org/mpris/MediaPlayer2",
             "org.mpris.MediaPlayer2.Fullscreen"],
            capture_output=True, text=True, timeout=2
        )
        return r.stdout.strip().lower() == "true"
    except Exception:
        return False


_STEAM_HELPER_PATHS = (
    "/ubuntu12_32/",
    "/ubuntu12_64/",
    "/.steam/root/",
    "/steam-runtime/",
    "/pressure-vessel/",
)

def _has_steam_game_id(pid_dir):
    """Check if process has SteamGameId env var set to a non-zero value (i.e. it's a game, not the Steam client)."""
    try:
        environ = (pid_dir / "environ").read_bytes()
        if b"SteamGameId=" not in environ:
            return False
        for entry in environ.split(b"\x00"):
            if entry.startswith(b"SteamGameId="):
                val = entry.split(b"=", 1)[1]
                if not (val.isdigit() and int(val) > 0):
                    return False
                try:
                    exe = os.readlink(pid_dir / "exe")
                    if any(p in exe for p in _STEAM_HELPER_PATHS):
                        return False
                except OSError:
                    pass
                return True
    except OSError:
        pass
    return False


def _is_exclusive_fullscreen():
    """Return True if any XWayland window has _NET_WM_STATE_FULLSCREEN set."""
    try:
        out = subprocess.check_output(
            ["xdotool", "search", "--onlyvisible", "--name", ""],
            stderr=subprocess.DEVNULL, text=True, timeout=3
        ).strip().splitlines()
        for wid in out:
            wid = wid.strip()
            if not wid:
                continue
            try:
                props = subprocess.check_output(
                    ["xprop", "-id", wid, "_NET_WM_STATE"],
                    stderr=subprocess.DEVNULL, text=True, timeout=2
                )
                if "_NET_WM_STATE_FULLSCREEN" in props:
                    return True
            except Exception:
                continue
    except Exception:
        pass
    return False


def _is_game_process_running():
    for pid_dir in Path("/proc").iterdir():
        if not pid_dir.name.isdigit():
            continue
        try:
            if _has_steam_game_id(pid_dir):
                return True
            if GAME_PATHS:
                exe = os.readlink(pid_dir / "exe")
                if any(p in exe for p in GAME_PATHS):
                    return True
                cmdline = (pid_dir / "cmdline").read_bytes().decode("utf-8", errors="ignore")
                if any(p in cmdline for p in GAME_PATHS):
                    return True
        except OSError:
            continue
    return False


def is_game_running():
    if not _is_game_process_running():
        return is_vlc_fullscreen()
    return _is_exclusive_fullscreen()


def start_overlay():
    global overlay_proc
    if overlay_proc and overlay_proc.poll() is None:
        return
    opacity = DIM_LEVEL / 100
    overlay_proc = subprocess.Popen(
        ["python3", str(OVERLAY_BIN), str(opacity)],
        env={**os.environ,
             "DISPLAY": os.environ.get("DISPLAY", ":0"),
             "WAYLAND_DISPLAY": os.environ.get("WAYLAND_DISPLAY", "wayland-0")}
    )


def stop_overlay():
    global overlay_proc
    if overlay_proc and overlay_proc.poll() is None:
        overlay_proc.terminate()
        try:
            overlay_proc.wait(timeout=2)
        except subprocess.TimeoutExpired:
            overlay_proc.kill()
    overlay_proc = None


def set_brightness(level):
    if RIGHT_BUS is None:
        return
    subprocess.run(
        ["ddcutil", "setvcp", "10", str(level), "--bus", str(RIGHT_BUS)],
        capture_output=True, timeout=5
    )


def dim_on():
    if USE_OVERLAY:
        start_overlay()
    else:
        set_brightness(100 - DIM_LEVEL)


def dim_off():
    if USE_OVERLAY:
        stop_overlay()
    else:
        set_brightness(100)


TRAY_ICON_NAME = "monitor-dimmer-symbolic"

def make_icon(active):
    size = 64
    img  = Image.new("RGBA", (size, size), (0, 0, 0, 0))
    d    = ImageDraw.Draw(img)

    # Colours: white active, dim grey inactive — blends with any panel colour
    fg      = (255, 255, 255, 230) if active else (180, 180, 180, 140)
    fg_dim  = (255, 255, 255, 70)  if active else (180, 180, 180, 50)

    # Monitor frame
    d.rounded_rectangle([3, 4, 61, 46], radius=4, outline=fg, width=3)
    # Left half bright
    d.rectangle([4, 5, 32, 45], fill=fg)
    # Right half dimmed
    d.rounded_rectangle([32, 5, 60, 45], radius=3, fill=fg_dim)
    # Divider line
    d.line([32, 5, 32, 45], fill=fg, width=2)
    # Stand
    d.line([22, 46, 42, 46], fill=fg, width=3)
    d.rounded_rectangle([16, 50, 48, 56], radius=2, fill=fg)

    return img


def monitor_loop(icon):
    global game_active
    while True:
        time.sleep(POLL_INTERVAL)
        with lock:
            was_active = game_active
        running = is_game_running()
        with lock:
            game_active = running
        if running and not was_active:
            dim_on()
        elif not running and was_active:
            dim_off()


def on_toggle_mode(icon, item):
    global USE_OVERLAY
    with lock:
        currently_dimming = game_active
    if currently_dimming:
        dim_off()
    USE_OVERLAY = not USE_OVERLAY
    icon.update_menu()
    if currently_dimming:
        dim_on()


def on_settings(icon, item):
    config_bin = Path.home() / ".local/bin/dimmer"
    cmd = f"python3 {config_bin}; read -p 'Press Enter to close...'"
    for term in ("konsole", "gnome-terminal", "xterm"):
        try:
            subprocess.Popen([term, "-e", "bash", "-c", cmd],
                             start_new_session=True)
            return
        except FileNotFoundError:
            continue


def on_quit(icon, item):
    dim_off()
    icon.stop()
    os._exit(0)


def main():
    icon = pystray.Icon("monitor-dimmer")
    icon.icon = make_icon(True)
    icon.title = "Monitor Dimmer"
    icon.menu = pystray.Menu(
        pystray.MenuItem(
            lambda item: "Mode: Overlay" if USE_OVERLAY else "Mode: DDC Brightness",
            on_toggle_mode,
        ),
        pystray.MenuItem("Settings", on_settings),
        pystray.MenuItem("Quit", on_quit),
    )
    t = threading.Thread(target=monitor_loop, args=(icon,), daemon=True)
    t.start()
    icon.run()


if __name__ == "__main__":
    main()
