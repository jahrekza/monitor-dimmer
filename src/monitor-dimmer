#!/usr/bin/env python3
"""Monitor Dimmer daemon. `monitor-dimmer --restore` undoes a leftover DDC dim."""
import os
import re
import signal
import subprocess
import sys
import threading
import time
from pathlib import Path

import dimmer_common as dc
from fullscreen_watch import FullscreenWatcher

CFG = dc.load_config()
CFG_MTIME = dc.config_mtime()

lock        = threading.RLock()  # tray thread and monitor loop share all state below
detected    = None               # what triggered the dim: "game", "VLC", "video" or None
force_on    = False              # "Dim now" from the tray
monitors    = []                 # connected monitors, refreshed on demand
overlays    = {}                 # dc.screen_key(screen) -> overlay Popen
watcher     = FullscreenWatcher(dc.STATE_DIR / "kwin-fullscreen.js")
tray        = None


# ── Detection ─────────────────────────────────────────────────────────────────

def is_vlc_fullscreen():
    try:
        names = subprocess.run(
            ["gdbus", "call", "--session", "--dest", "org.freedesktop.DBus",
             "--object-path", "/org/freedesktop/DBus",
             "--method", "org.freedesktop.DBus.ListNames"],
            capture_output=True, text=True, timeout=2).stdout
        # one name per VLC window: org.mpris.MediaPlayer2.vlc[.instanceNNN]
        for name in set(re.findall(r"org\.mpris\.MediaPlayer2\.vlc[\w.]*", names)):
            r = subprocess.run(
                ["gdbus", "call", "--session", "--dest", name,
                 "--object-path", "/org/mpris/MediaPlayer2",
                 "--method", "org.freedesktop.DBus.Properties.Get",
                 "org.mpris.MediaPlayer2", "Fullscreen"],
                capture_output=True, text=True, timeout=2)
            if "true" in r.stdout:
                return True
    except (OSError, subprocess.TimeoutExpired):
        pass
    return False


_STEAM_HELPER_PATHS = (
    "/ubuntu12_32/",
    "/ubuntu12_64/",
    "/.steam/root/",
    "/steam-runtime/",
    "/pressure-vessel/",
)

def _has_steam_game_id(pid_dir):
    """Check if process has SteamGameId env var set to a non-zero value (i.e. it's a game, not the Steam client)."""
    try:
        environ = (pid_dir / "environ").read_bytes()
        if b"SteamGameId=" not in environ:
            return False
        for entry in environ.split(b"\x00"):
            if entry.startswith(b"SteamGameId="):
                val = entry.split(b"=", 1)[1]
                if not (val.isdigit() and int(val) > 0):
                    return False
                try:
                    exe = os.readlink(pid_dir / "exe")
                    if any(p in exe for p in _STEAM_HELPER_PATHS):
                        return False
                except OSError:
                    pass
                return True
    except OSError:
        pass
    return False


def game_dirs():
    # /proc/*/exe is fully resolved: on Fedora Atomic /home is a symlink to
    # /var/home, so match both the configured and the resolved spelling
    return sorted({d.rstrip("/") + "/" for p in CFG["game_paths"]
                   for d in (p, os.path.realpath(p))})

GAME_DIRS = game_dirs()

def _in_game_dir(path):
    return any(path.startswith(d) for d in GAME_DIRS)


def _is_game_launch_arg(arg):
    # Wine shows the game as "Z:\home\...\game.exe"; only count executables,
    # so a file manager or shell sitting in a game folder doesn't trigger
    arg = arg.replace("\\", "/")
    if arg[1:3] == ":/":
        arg = arg[2:]
    return arg.lower().endswith(".exe") and _in_game_dir(arg)


def _is_game_process_running():
    for pid_dir in Path("/proc").iterdir():
        if not pid_dir.name.isdigit():
            continue
        try:
            if _has_steam_game_id(pid_dir):
                return True
            if GAME_DIRS:
                if _in_game_dir(os.readlink(pid_dir / "exe")):
                    return True
                args = (pid_dir / "cmdline").read_bytes().decode("utf-8", errors="ignore")
                if any(_is_game_launch_arg(a) for a in args.split("\x00")):
                    return True
        except OSError:
            continue
    return False


def detect():
    """Return what should trigger dimming right now, or None."""
    fullscreen = False                            # fetched lazily, at most once
    def windows():
        nonlocal fullscreen
        if fullscreen is False:
            fullscreen = watcher.windows()
            if fullscreen is not None:
                # our own overlays are fullscreen windows too
                with lock:
                    ours = {p.pid for p in overlays.values()}
                fullscreen = [w for w in fullscreen if w["pid"] not in ours]
        return fullscreen

    if CFG["detect_games"] and _is_game_process_running():
        # Unknown window state (no KWin, no xdotool) counts as fullscreen
        if not CFG["require_fullscreen"] or windows() is None or windows():
            return "game"
    if CFG["vlc_fullscreen"] and is_vlc_fullscreen():
        return "VLC"
    if CFG["video_fullscreen"] and CFG["video_titles"]:
        titles = [t.lower() for t in CFG["video_titles"]]
        for w in windows() or []:
            if any(t in w["caption"].lower() for t in titles):
                return "video"
    return None


# ── Dimming, per screen ───────────────────────────────────────────────────────

def overlay_key(screen):
    # the level is part of the key, so changing it restarts the overlay
    return dc.screen_key(screen) + (dc.screen_level(CFG, screen),)


def start_overlay(screen):
    p = overlays.get(overlay_key(screen))
    if p and p.poll() is None:
        return
    cmd = [sys.executable, str(dc.OVERLAY_BIN),
           "--opacity", str(dc.screen_level(CFG, screen) / 100), *dc.overlay_args(screen)]
    overlays[overlay_key(screen)] = subprocess.Popen(cmd)


def stop_overlay(key):
    p = overlays.pop(key, None)
    if p and p.poll() is None:
        p.terminate()
        try:
            p.wait(timeout=2)
        except subprocess.TimeoutExpired:
            p.kill()


def ddc_dim(screen, state, displays):
    ident = dc.identity_of(screen)
    level = dc.screen_level(CFG, screen)
    for e in state:
        if e.get("screen") == ident:              # already dimmed: follow a level change
            dc.set_brightness(e["bus"], dc.dimmed_value(e["brightness"], level))
            return
    bus = dc.find_bus(screen, displays)
    current = dc.get_brightness(bus) if bus is not None else None
    if current is None:
        dc.warn(f"{dc.screen_label(screen)}: not reachable via ddcutil")
        return
    # Save before dimming, so a crash right after can still restore
    state.append({"screen": ident, "bus": bus, "brightness": current[0]})
    dc.save_state(state)
    dc.set_brightness(bus, dc.dimmed_value(current[0], level))


def ddc_restore(state, keep=lambda entry: False, displays=None):
    """Restore every saved screen except those `keep` says stay dimmed."""
    remaining = []
    for e in state:
        if keep(e):
            remaining.append(e)
            continue
        # Re-locate the monitor: the bus may have changed since dimming
        bus = dc.find_bus(e["screen"], displays) if dc.has_identity(e.get("screen", {})) else None
        if bus is None:
            bus = e["bus"]
        if not dc.set_brightness(bus, e["brightness"]):
            remaining.append(e)
    dc.save_state(remaining)
    return remaining


def apply():
    """Bring every screen in line with its mode and the current dim state."""
    with lock:
        want = force_on or (CFG["auto_dim"] and detected is not None)
        overlay_on = {overlay_key(s) for s in CFG["screens"] if want and s["mode"] == "overlay"}
        ddc_on = [dc.identity_of(s) for s in CFG["screens"] if want and s["mode"] == "ddc"]

        for key in [k for k in overlays if k not in overlay_on]:
            stop_overlay(key)

        state = dc.load_state()
        displays = dc.ddc_displays() if (state or ddc_on) else []
        state = ddc_restore(state, keep=lambda e: e.get("screen") in ddc_on, displays=displays)
        for s in CFG["screens"]:
            if overlay_key(s) in overlay_on:
                start_overlay(s)
            elif want and s["mode"] == "ddc":
                ddc_dim(s, state, displays)
    update_tray()


def undim_all():
    with lock:
        for key in list(overlays):
            stop_overlay(key)
        state = dc.load_state()
        if state:
            ddc_restore(state)


def reload_config_if_changed():
    """Pick up edits from the settings wizard (or by hand) without a restart."""
    global CFG_MTIME, GAME_DIRS
    mtime = dc.config_mtime()
    if mtime == CFG_MTIME:
        return False
    with lock:
        CFG_MTIME = mtime
        CFG.clear()
        CFG.update(dc.load_config())
        GAME_DIRS = game_dirs()
    return True


def monitor_loop():
    global detected
    while True:
        time.sleep(CFG["poll_interval"])
        watcher.check()
        reloaded = reload_config_if_changed()
        now = detect() if CFG["auto_dim"] else None
        with lock:
            changed, detected = now != detected, now
        if changed or reloaded:
            apply()


# ── Tray ──────────────────────────────────────────────────────────────────────

def make_icon(active):
    from PIL import Image, ImageDraw
    size = 64
    img  = Image.new("RGBA", (size, size), (0, 0, 0, 0))
    d    = ImageDraw.Draw(img)

    # Colours: white active, dim grey inactive — blends with any panel colour
    fg      = (255, 255, 255, 230) if active else (180, 180, 180, 140)
    fg_dim  = (255, 255, 255, 70)  if active else (180, 180, 180, 50)

    # Monitor frame
    d.rounded_rectangle([3, 4, 61, 46], radius=4, outline=fg, width=3)
    # Left half bright
    d.rectangle([4, 5, 32, 45], fill=fg)
    # Right half dimmed
    d.rounded_rectangle([32, 5, 60, 45], radius=3, fill=fg_dim)
    # Divider line
    d.line([32, 5, 32, 45], fill=fg, width=2)
    # Stand
    d.line([22, 46, 42, 46], fill=fg, width=3)
    d.rounded_rectangle([16, 50, 48, 56], radius=2, fill=fg)

    return img


def status_text():
    if force_on:
        return "Dimmed (manual)"
    if not CFG["auto_dim"]:
        return "Auto-dim off"
    if detected:
        return f"Dimmed ({detected})"
    return "Watching"


def update_tray():
    if tray is not None:
        tray.icon = make_icon(CFG["auto_dim"] or force_on)
        tray.update_menu()


def save_and_apply():
    global CFG_MTIME
    with lock:
        dc.save_config(CFG)
        CFG_MTIME = dc.config_mtime()             # our own write: no reload
    apply()


def refresh_monitors():
    global monitors
    found = dc.all_monitors()
    with lock:
        monitors = found
    update_tray()


def on_toggle_auto(icon, item):
    global detected
    with lock:
        CFG["auto_dim"] = not CFG["auto_dim"]
        if not CFG["auto_dim"]:
            detected = None
    save_and_apply()


def on_toggle_force(icon, item):
    global force_on
    with lock:
        force_on = not force_on
    apply()


def toggle_option(key):
    def handler(icon, item):
        with lock:
            CFG[key] = not CFG[key]
        save_and_apply()
    return handler


def set_screen(screen, **values):
    def handler(icon, item):
        with lock:
            # the menu may hold a copy from before a config reload
            hit = dc.find_monitor(screen, CFG["screens"])
            if hit is None:
                hit = dict(screen)
                CFG["screens"].append(hit)        # first time this monitor is used
            hit.update(values)
        save_and_apply()
    return handler


def screen_menu(pystray):
    with lock:
        entries = dc.merge_screens(CFG, monitors)
    items = []
    for screen, connected in entries:
        if not connected and screen["mode"] == "off":
            continue
        label = dc.screen_label(screen) + ("" if connected else " — disconnected")
        modes = [
            pystray.MenuItem(
                text, set_screen(screen, mode=mode),
                checked=lambda item, s=screen, m=mode: s["mode"] == m,
                radio=True,
                # brightness needs DDC/CI; the bus is known once ddcutil saw it
                enabled=mode != "ddc" or screen.get("bus") is not None,
            )
            for mode, text in (("off", "Not dimmed"), ("overlay", "Overlay (black window)"),
                               ("ddc", "Brightness (DDC/CI)"))
        ]
        # how strongly: overlay opacity or how much the brightness drops
        levels = [pystray.MenuItem(
            f"Default ({CFG['dim_level']}%)", set_screen(screen, level=None),
            checked=lambda item, s=screen: s.get("level") is None, radio=True)]
        levels += [pystray.MenuItem(
            f"{v}%", set_screen(screen, level=v),
            checked=lambda item, s=screen, v=v: s.get("level") == v, radio=True)
            for v in dc.LEVELS]
        levels_item = pystray.MenuItem(
            lambda item, s=screen: f"Dim level: {dc.screen_level(CFG, s)}%",
            pystray.Menu(*levels), enabled=screen["mode"] != "off")
        items.append(pystray.MenuItem(label, pystray.Menu(
            *modes, pystray.Menu.SEPARATOR, levels_item)))
    if not items:
        items.append(pystray.MenuItem("No screens found", None, enabled=False))
    items += [pystray.Menu.SEPARATOR,
              pystray.MenuItem("Refresh screen list",
                               lambda icon, item: threading.Thread(target=refresh_monitors).start())]
    return items


def on_settings(icon, item):
    wizard = Path(__file__).resolve().parent / "dimmer"
    if not dc.open_in_terminal([sys.executable, str(wizard)]):
        dc.warn("no terminal emulator found — run `dimmer` from a terminal")


def shutdown(*_):
    undim_all()
    watcher.stop()
    os._exit(0)


def on_quit(icon, item):
    shutdown()


def import_pystray():
    try:
        import pystray
        return pystray
    except Exception as e:
        # PYSTRAY_BACKEND=appindicator fails hard when AppIndicator is missing
        if os.environ.pop("PYSTRAY_BACKEND", None):
            for mod in [m for m in sys.modules if m.startswith("pystray")]:
                del sys.modules[mod]
            try:
                import pystray
                return pystray
            except Exception as e2:
                e = e2
        dc.warn(f"tray icon unavailable ({e}); running without it")
        return None


def build_menu(pystray):
    opt = lambda text, key: pystray.MenuItem(
        text, toggle_option(key), checked=lambda item: CFG[key])
    return pystray.Menu(
        pystray.MenuItem(lambda item: status_text(), None, enabled=False),
        pystray.Menu.SEPARATOR,
        pystray.MenuItem("Auto-dim", on_toggle_auto, checked=lambda item: CFG["auto_dim"]),
        pystray.MenuItem("Dim now", on_toggle_force, checked=lambda item: force_on),
        pystray.Menu.SEPARATOR,
        pystray.MenuItem("Screens", pystray.Menu(lambda: screen_menu(pystray))),
        pystray.MenuItem("Detect", pystray.Menu(
            opt("Games", "detect_games"),
            opt("Games only when fullscreen", "require_fullscreen"),
            opt("VLC fullscreen", "vlc_fullscreen"),
            opt("Fullscreen video in browser (YouTube…)", "video_fullscreen"),
        )),
        pystray.Menu.SEPARATOR,
        pystray.MenuItem("Settings…", on_settings),
        pystray.MenuItem("Quit", on_quit),
    )


def run_tray(pystray):
    global tray
    icon = pystray.Icon("monitor-dimmer")
    icon.icon = make_icon(CFG["auto_dim"])
    icon.title = "Monitor Dimmer"
    icon.menu = build_menu(pystray)
    tray = icon
    icon.run()


def restore_leftover_dim():
    """A previous run died while dimming: put the brightness back."""
    state = dc.load_state()
    if state:
        ddc_restore(state, displays=dc.ddc_displays())


def migrate_config():
    """Bus-only screens from old configs: record which monitor sits there."""
    bus_only = [s for s in CFG["screens"] if not dc.has_identity(s) and s["bus"] is not None]
    if not bus_only:
        return
    displays = dc.ddc_displays()
    for s in bus_only:
        for d in displays:
            if d["bus"] == s["bus"]:
                s.update({k: v for k, v in dc.identity_of(d).items() if v is not None})
                print(f"Screen identified as {dc.screen_label(s)}; saved to config", flush=True)
    save_and_apply()


def main():
    if "--restore" in sys.argv[1:]:
        restore_leftover_dim()
        return

    restore_leftover_dim()
    migrate_config()
    signal.signal(signal.SIGTERM, shutdown)
    signal.signal(signal.SIGINT, shutdown)
    if not watcher.start():
        dc.warn("KWin not available; fullscreen windows are read via xdotool/xprop")
    refresh_monitors()
    threading.Thread(target=monitor_loop, daemon=True).start()

    pystray = import_pystray()
    if pystray:
        try:
            run_tray(pystray)
        except Exception as e:
            # e.g. no notification service / no tray host on this desktop
            dc.warn(f"tray icon failed ({e}); running without it")
    while True:
        signal.pause()


if __name__ == "__main__":
    main()
