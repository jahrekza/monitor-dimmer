#!/usr/bin/env python3
"""Black overlay window on the dim target screen.

    monitor-dimmer-overlay --opacity 0.7 [--model M] [--sn S] [--connector C]
    monitor-dimmer-overlay --list      # print the screens as JSON
"""
import argparse
import json
import signal
import sys

from PyQt6.QtWidgets import QApplication, QWidget
from PyQt6.QtCore import Qt, QTimer, qInstallMessageHandler
from PyQt6.QtGui import QColor, QPainter

from dimmer_common import find_monitor


def screen_info(s):
    model = s.model()
    # KWin reports some models prefixed with the connector ("DP-2-MAG 341C")
    if model.startswith(s.name() + "-"):
        model = model[len(s.name()) + 1:]
    return {"connector": s.name(), "mfg": s.manufacturer(),
            "model": model, "sn": s.serialNumber()}


class Overlay(QWidget):
    def __init__(self, opacity, translucent):
        super().__init__()
        self.setWindowFlags(
            Qt.WindowType.FramelessWindowHint |
            Qt.WindowType.WindowStaysOnTopHint |
            Qt.WindowType.Tool |
            Qt.WindowType.WindowDoesNotAcceptFocus |    # don't steal the game's focus
            Qt.WindowType.WindowTransparentForInput     # clicks reach the windows below
        )
        self.setAttribute(Qt.WidgetAttribute.WA_ShowWithoutActivating)
        if translucent:
            # setWindowOpacity() is a no-op on Wayland: paint translucent black
            self.color = QColor(0, 0, 0, round(opacity * 255))
            self.setAttribute(Qt.WidgetAttribute.WA_TranslucentBackground)
        else:
            self.color = QColor(0, 0, 0)
            self.setWindowOpacity(opacity)

    def paintEvent(self, event):
        QPainter(self).fillRect(self.rect(), self.color)


def quiet_activation_warning(mode, context, message):
    # showFullScreen() asks to activate the window even though it is marked
    # WindowDoesNotAcceptFocus; Qt warns about it on every dim
    if "requestActivate()" not in message:
        print(message, file=sys.stderr)


def main():
    qInstallMessageHandler(quiet_activation_warning)
    ap = argparse.ArgumentParser()
    ap.add_argument("--list", action="store_true")
    ap.add_argument("--opacity", type=float, default=0.7)
    ap.add_argument("--model")
    ap.add_argument("--sn")
    ap.add_argument("--connector")
    args = ap.parse_args()

    app = QApplication(sys.argv[:1])
    screens = app.screens()
    infos = [screen_info(s) for s in screens]

    if args.list:
        print(json.dumps(infos))
        return

    hit = find_monitor({"model": args.model, "sn": args.sn,
                        "connector": args.connector}, infos)
    if hit is None:
        print("Dim target screen not found", file=sys.stderr)
        sys.exit(1)
    target = screens[infos.index(hit)]

    w = Overlay(min(max(args.opacity, 0.0), 1.0),
                translucent=app.platformName() != "xcb")
    w.setGeometry(target.geometry())
    w.winId()                                   # create the native window
    w.windowHandle().setScreen(target)
    w.showFullScreen()

    signal.signal(signal.SIGTERM, lambda *_: app.quit())
    signal.signal(signal.SIGINT,  lambda *_: app.quit())
    # Python only runs signal handlers between bytecodes; without a timer the
    # Qt event loop never yields and SIGTERM is ignored.
    tick = QTimer()
    tick.timeout.connect(lambda: None)
    tick.start(200)

    sys.exit(app.exec())


if __name__ == "__main__":
    main()
