#!/usr/bin/env python3
import subprocess
import sys
import time

import dimmer_common as dc

SERVICE = "monitor-dimmer.service"

RESET  = "\033[0m"
BOLD   = "\033[1m"
CYAN   = "\033[96m"
GREEN  = "\033[92m"
YELLOW = "\033[93m"
RED    = "\033[91m"
DIM    = "\033[2m"


def service_status():
    try:
        r = subprocess.run(
            ["systemctl", "--user", "is-active", SERVICE],
            capture_output=True, text=True
        )
        return r.stdout.strip()
    except OSError:
        return "unknown"


def ask_int(prompt, min_val, max_val, default):
    while True:
        raw = input(f"{prompt} [{default}]: ").strip()
        if raw == "":
            return default
        try:
            v = int(raw)
            if min_val <= v <= max_val:
                return v
            print(f"{RED}  Enter a number between {min_val} and {max_val}{RESET}")
        except ValueError:
            print(f"{RED}  Not a number{RESET}")


def print_header():
    print(f"\n{BOLD}{CYAN}╔══════════════════════════════════════╗")
    print(f"║   Monitor Dimmer — Configuration     ║")
    print(f"╚══════════════════════════════════════╝{RESET}\n")


def print_status(cfg):
    status = service_status()
    dot    = f"{GREEN}●{RESET}" if status == "active" else f"{RED}●{RESET}"
    mode   = (f"{CYAN}overlay{RESET} (black window)"
              if cfg["use_overlay"] else f"{YELLOW}dim{RESET} (hardware brightness)")
    vlc    = f"{GREEN}yes{RESET}" if cfg["vlc_fullscreen"] else f"{DIM}no{RESET}"
    fs     = f"{GREEN}yes{RESET}" if cfg["require_fullscreen"] else f"{DIM}no{RESET}"
    paths  = len(cfg["game_paths"])

    print(f"  Service status:     {dot} {status}")
    print(f"  Dim method:         {mode}")
    print(f"  Dim target:         {YELLOW}{dc.target_label(cfg)}{RESET}")
    print(f"  Dim intensity:      {YELLOW}{cfg['dim_level']}%{RESET}  {DIM}(0=none, 100=black){RESET}")
    print(f"  Poll interval:      {YELLOW}{cfg['poll_interval']}s{RESET}")
    print(f"  VLC fullscreen:     {vlc}")
    print(f"  Fullscreen only:    {fs}  {DIM}(dim only while the game is fullscreen){RESET}")
    print(f"  Game paths:         {YELLOW}{paths}{RESET} configured")
    print()


def menu_test_dim(cfg):
    """Returns True if the dim worked."""
    print(f"\n{YELLOW}▸ Testing dim for 3 seconds...{RESET}")
    if cfg["use_overlay"]:
        if not dc.has_target(cfg):
            print(f"{RED}  No dim target — choose a monitor first{RESET}")
            return False
        cmd = [sys.executable, str(dc.OVERLAY_BIN), "--opacity", str(cfg["dim_level"] / 100)]
        for flag, key in (("--model", "target_model"), ("--sn", "target_sn"),
                          ("--connector", "target_connector")):
            if cfg[key]:
                cmd += [flag, cfg[key]]
        proc = subprocess.Popen(cmd)
        time.sleep(3)
        proc.terminate()
        if proc.wait() != 0:
            print(f"{RED}  Dim target screen not found — choose it again{RESET}")
            return False
    else:
        bus   = dc.find_target_bus(cfg)
        level = dc.get_brightness(bus) if bus is not None else None
        if level is None:
            print(f"{RED}  Dim target not reachable via ddcutil — choose it again{RESET}")
            return False
        current, _max = level
        dc.set_brightness(bus, dc.dimmed_value(current, cfg["dim_level"]))
        time.sleep(3)
        dc.set_brightness(bus, current)
    print(f"{GREEN}✓ Done.{RESET}")
    return True


def menu_pick_monitor(cfg):
    print(f"{DIM}  Detecting monitors...{RESET}")
    monitors = dc.all_monitors()
    if not cfg["use_overlay"]:
        monitors = [m for m in monitors if m.get("bus") is not None]
        if not monitors:
            print(f"{RED}  No DDC/CI monitors found — use overlay mode, "
                  f"or check `ddcutil detect`{RESET}")
            return
    if not monitors:
        print(f"{RED}  No monitors detected{RESET}")
        return
    current = dc.find_target(cfg, monitors)
    for i, m in enumerate(monitors, 1):
        mark = f"  {GREEN}← current{RESET}" if m is current else ""
        print(f"  {BOLD}{i}{RESET}  {dc.monitor_label(m)}{mark}")
    idx = ask_int("\n  Monitor to dim", 1, len(monitors), 1) - 1
    dc.set_target(cfg, monitors[idx])
    print(f"{GREEN}✓ Dim target: {dc.target_label(cfg)}{RESET}")


def menu_start_service():
    if service_status() == "active":
        print(f"\n{DIM}Service is already running.{RESET}")
        return
    subprocess.run(["systemctl", "--user", "start", SERVICE])
    print(f"\n{GREEN}▶  Service started.{RESET}")


def menu_stop_service():
    if service_status() != "active":
        print(f"\n{DIM}Service is not running.{RESET}")
        return
    subprocess.run(["systemctl", "--user", "stop", SERVICE])
    print(f"\n{YELLOW}⏹  Service stopped.{RESET}")


def apply_config(cfg):
    dc.save_config(cfg)
    if service_status() == "active":
        subprocess.run(["systemctl", "--user", "restart", SERVICE])
    print(f"\n{GREEN}✓ Saved and applied.{RESET}")


def main():
    print_header()
    cfg = dc.load_config()

    while True:
        print_status(cfg)
        mode_label = ("Switch to dim (hardware brightness)"
                      if cfg["use_overlay"] else "Switch to overlay (black window)")
        vlc_label  = ("Disable VLC fullscreen detection"
                      if cfg["vlc_fullscreen"] else "Enable VLC fullscreen detection")
        fs_label   = ("Dim whenever a game runs"
                      if cfg["require_fullscreen"] else "Dim only while a game is fullscreen")

        print(f"  {BOLD}1{RESET}  Change dim intensity     ({cfg['dim_level']}%)")
        print(f"  {BOLD}2{RESET}  Change poll interval     ({cfg['poll_interval']}s)")
        print(f"  {BOLD}3{RESET}  Test dim")
        print(f"  {BOLD}4{RESET}  {mode_label}")
        print(f"  {BOLD}5{RESET}  {vlc_label}")
        print(f"  {BOLD}6{RESET}  {fs_label}")
        print(f"  {BOLD}7{RESET}  Choose monitor to dim    ({dc.target_label(cfg)})")
        print(f"  {BOLD}8{RESET}  Start service")
        print(f"  {BOLD}9{RESET}  Stop service")
        print(f"  {BOLD}s{RESET}  Save and exit")
        print(f"  {BOLD}q{RESET}  Quit without saving\n")

        choice = input(f"{CYAN}Choose option: {RESET}").strip().lower()
        print()

        if choice == "1":
            print(f"{DIM}  0 = no change, 50 = half brightness, 100 = completely black{RESET}")
            cfg["dim_level"] = ask_int("  Dim intensity (0–100)", 0, 100, cfg["dim_level"])
        elif choice == "2":
            print(f"{DIM}  Lower = faster reaction, more CPU{RESET}")
            cfg["poll_interval"] = ask_int("  Poll interval in seconds (2–60)", 2, 60, cfg["poll_interval"])
        elif choice == "3":
            menu_test_dim(cfg)
        elif choice == "4":
            cfg["use_overlay"] = not cfg["use_overlay"]
            mode = "overlay (black window)" if cfg["use_overlay"] else "dim (hardware brightness)"
            print(f"{GREEN}✓ Switched to: {mode}{RESET}")
            if not cfg["use_overlay"] and dc.find_target_bus(cfg) is None:
                print(f"{YELLOW}  The current target has no DDC/CI — choose a monitor (7){RESET}")
        elif choice == "5":
            cfg["vlc_fullscreen"] = not cfg["vlc_fullscreen"]
            state = "enabled" if cfg["vlc_fullscreen"] else "disabled"
            print(f"{GREEN}✓ VLC fullscreen detection {state}.{RESET}")
        elif choice == "6":
            cfg["require_fullscreen"] = not cfg["require_fullscreen"]
            state = "only while fullscreen" if cfg["require_fullscreen"] else "whenever a game runs"
            print(f"{GREEN}✓ Dimming {state}.{RESET}")
            if cfg["require_fullscreen"]:
                print(f"{DIM}  Sees X11/XWayland windows only (via xdotool + xprop): native{RESET}")
                print(f"{DIM}  Wayland games never count as fullscreen, so leave this off for them.{RESET}")
                print(f"{DIM}  Without xdotool/xprop every game counts as fullscreen.{RESET}")
        elif choice == "7":
            menu_pick_monitor(cfg)
        elif choice == "8":
            menu_start_service()
        elif choice == "9":
            menu_stop_service()
        elif choice == "s":
            apply_config(cfg)
            break
        elif choice == "q":
            break
        else:
            print(f"{RED}  Unknown option{RESET}")
        print()


if __name__ == "__main__":
    if "--test" in sys.argv[1:]:                # used by install.py
        sys.exit(0 if menu_test_dim(dc.load_config()) else 1)
    try:
        main()
    except (KeyboardInterrupt, EOFError):
        print(f"\n{DIM}Cancelled.{RESET}\n")
