#!/usr/bin/env python3
import subprocess
import sys
import time

import dimmer_common as dc

SERVICE = "monitor-dimmer.service"

RESET  = "\033[0m"
BOLD   = "\033[1m"
CYAN   = "\033[96m"
GREEN  = "\033[92m"
YELLOW = "\033[93m"
RED    = "\033[91m"
DIM    = "\033[2m"

MODE_TEXT = {"off": "not dimmed", "overlay": "overlay (black window)",
             "ddc": "brightness (DDC/CI)"}


def service_status():
    try:
        r = subprocess.run(
            ["systemctl", "--user", "is-active", SERVICE],
            capture_output=True, text=True
        )
        return r.stdout.strip()
    except OSError:
        return "unknown"


def ask_int(prompt, min_val, max_val, default):
    while True:
        raw = input(f"{prompt} [{default}]: ").strip()
        if raw == "":
            return default
        try:
            v = int(raw)
            if min_val <= v <= max_val:
                return v
            print(f"{RED}  Enter a number between {min_val} and {max_val}{RESET}")
        except ValueError:
            print(f"{RED}  Not a number{RESET}")


def yes_no(v):
    return f"{GREEN}yes{RESET}" if v else f"{DIM}no{RESET}"


def print_header():
    print(f"\n{BOLD}{CYAN}╔══════════════════════════════════════╗")
    print(f"║   Monitor Dimmer — Configuration     ║")
    print(f"╚══════════════════════════════════════╝{RESET}\n")


def print_status(cfg):
    status = service_status()
    dot    = f"{GREEN}●{RESET}" if status == "active" else f"{RED}●{RESET}"

    print(f"  Service status:     {dot} {status}")
    print(f"  Auto-dim:           {yes_no(cfg['auto_dim'])}")
    print(f"  Dimmed screens:")
    active = dc.active_screens(cfg)
    for s in active:
        print(f"    {YELLOW}{dc.screen_label(s)}{RESET} — {MODE_TEXT[s['mode']]}")
    if not active:
        print(f"    {DIM}none — choose screens (4){RESET}")
    print(f"  Dim intensity:      {YELLOW}{cfg['dim_level']}%{RESET}  {DIM}(0=none, 100=black){RESET}")
    print(f"  Poll interval:      {YELLOW}{cfg['poll_interval']}s{RESET}")
    print(f"  Detect games:       {yes_no(cfg['detect_games'])}"
          f"   {DIM}only fullscreen:{RESET} {yes_no(cfg['require_fullscreen'])}")
    print(f"  VLC fullscreen:     {yes_no(cfg['vlc_fullscreen'])}")
    print(f"  Browser video:      {yes_no(cfg['video_fullscreen'])}"
          f"   {DIM}titles: {', '.join(cfg['video_titles']) or '—'}{RESET}")
    print(f"  Game paths:         {YELLOW}{len(cfg['game_paths'])}{RESET} configured")
    print()


def menu_test_dim(cfg):
    """Dim every configured screen for 3 seconds. Returns True if all worked."""
    print(f"\n{YELLOW}▸ Testing dim for 3 seconds...{RESET}")
    active = dc.active_screens(cfg)
    if not active:
        print(f"{RED}  No screens to dim — choose screens first{RESET}")
        return False
    ok = True
    procs, restore = [], []
    displays = dc.ddc_displays() if any(s["mode"] == "ddc" for s in active) else []
    for s in active:
        if s["mode"] == "overlay":
            procs.append((s, subprocess.Popen(
                [sys.executable, str(dc.OVERLAY_BIN), "--opacity",
                 str(cfg["dim_level"] / 100), *dc.overlay_args(s)])))
        else:
            bus   = dc.find_bus(s, displays)
            level = dc.get_brightness(bus) if bus is not None else None
            if level is None:
                print(f"{RED}  {dc.screen_label(s)}: not reachable via ddcutil{RESET}")
                ok = False
                continue
            dc.set_brightness(bus, dc.dimmed_value(level[0], cfg["dim_level"]))
            restore.append((bus, level[0]))
    time.sleep(3)
    for s, p in procs:
        p.terminate()
        if p.wait() != 0:
            print(f"{RED}  {dc.screen_label(s)}: screen not found{RESET}")
            ok = False
    for bus, value in restore:
        dc.set_brightness(bus, value)
    if ok:
        print(f"{GREEN}✓ Done.{RESET}")
    return ok


def menu_screens(cfg):
    print(f"{DIM}  Detecting monitors...{RESET}")
    entries = dc.merge_screens(cfg, dc.all_monitors())
    if not entries:
        print(f"{RED}  No monitors detected{RESET}")
        return
    for i, (s, connected) in enumerate(entries, 1):
        gone = "" if connected else f"  {DIM}(disconnected){RESET}"
        print(f"  {BOLD}{i}{RESET}  {dc.screen_label(s)} — {MODE_TEXT[s['mode']]}{gone}")
    idx = ask_int("\n  Screen to change (0 = back)", 0, len(entries), 0)
    if idx == 0:
        return
    screen, _ = entries[idx - 1]
    modes = ["off", "overlay"] + (["ddc"] if screen.get("bus") is not None else [])
    for i, m in enumerate(modes, 1):
        print(f"  {BOLD}{i}{RESET}  {MODE_TEXT[m]}")
    if "ddc" not in modes:
        print(f"  {DIM}(brightness unavailable: no DDC/CI on this screen){RESET}")
    choice = ask_int("  Mode", 1, len(modes), modes.index(screen["mode"]) + 1
                     if screen["mode"] in modes else 1)
    screen["mode"] = modes[choice - 1]
    if not any(s is screen for s in cfg["screens"]):
        cfg["screens"].append(screen)
    print(f"{GREEN}✓ {dc.screen_label(screen)}: {MODE_TEXT[screen['mode']]}{RESET}")


def menu_start_service():
    if service_status() == "active":
        print(f"\n{DIM}Service is already running.{RESET}")
        return
    subprocess.run(["systemctl", "--user", "start", SERVICE])
    print(f"\n{GREEN}▶  Service started.{RESET}")


def menu_stop_service():
    if service_status() != "active":
        print(f"\n{DIM}Service is not running.{RESET}")
        return
    subprocess.run(["systemctl", "--user", "stop", SERVICE])
    print(f"\n{YELLOW}⏹  Service stopped.{RESET}")


def apply_config(cfg):
    dc.save_config(cfg)
    if service_status() == "active":
        subprocess.run(["systemctl", "--user", "restart", SERVICE])
    print(f"\n{GREEN}✓ Saved and applied.{RESET}")


TOGGLES = {
    "5": ("detect_games",       "game detection"),
    "6": ("require_fullscreen", "games only when fullscreen"),
    "7": ("vlc_fullscreen",     "VLC fullscreen detection"),
    "8": ("video_fullscreen",   "browser video (YouTube…) detection"),
}


def main():
    print_header()
    cfg = dc.load_config()

    while True:
        print_status(cfg)
        print(f"  {BOLD}1{RESET}  Change dim intensity     ({cfg['dim_level']}%)")
        print(f"  {BOLD}2{RESET}  Change poll interval     ({cfg['poll_interval']}s)")
        print(f"  {BOLD}3{RESET}  Test dim")
        print(f"  {BOLD}4{RESET}  Choose screens and how they are dimmed")
        for key, (opt, text) in TOGGLES.items():
            print(f"  {BOLD}{key}{RESET}  {'Disable' if cfg[opt] else 'Enable'} {text}")
        print(f"  {BOLD}9{RESET}  Start service")
        print(f"  {BOLD}0{RESET}  Stop service")
        print(f"  {BOLD}s{RESET}  Save and exit")
        print(f"  {BOLD}q{RESET}  Quit without saving\n")

        choice = input(f"{CYAN}Choose option: {RESET}").strip().lower()
        print()

        if choice == "1":
            print(f"{DIM}  0 = no change, 50 = half brightness, 100 = completely black{RESET}")
            cfg["dim_level"] = ask_int("  Dim intensity (0–100)", 0, 100, cfg["dim_level"])
        elif choice == "2":
            print(f"{DIM}  Lower = faster reaction, more CPU{RESET}")
            cfg["poll_interval"] = ask_int("  Poll interval in seconds (2–60)", 2, 60, cfg["poll_interval"])
        elif choice == "3":
            menu_test_dim(cfg)
        elif choice == "4":
            menu_screens(cfg)
        elif choice in TOGGLES:
            opt, text = TOGGLES[choice]
            cfg[opt] = not cfg[opt]
            print(f"{GREEN}✓ {text[0].upper() + text[1:]} {'enabled' if cfg[opt] else 'disabled'}.{RESET}")
        elif choice == "9":
            menu_start_service()
        elif choice == "0":
            menu_stop_service()
        elif choice == "s":
            apply_config(cfg)
            break
        elif choice == "q":
            break
        else:
            print(f"{RED}  Unknown option{RESET}")
        print()


if __name__ == "__main__":
    if "--test" in sys.argv[1:]:                # used by install.py
        sys.exit(0 if menu_test_dim(dc.load_config()) else 1)
    try:
        main()
    except (KeyboardInterrupt, EOFError):
        print(f"\n{DIM}Cancelled.{RESET}\n")
